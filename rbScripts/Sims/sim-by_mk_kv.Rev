# mk simulator

outDir = args[1]
n_taxa = args[2] * 1
n_neo  = args[3] * 1
n_trans= args[4] * 1
# args[5] (gain_loss) unused - mk has no asymmetry
length = args[6] * 1
seed_v = args[7] * 1

write("Writing Mk simulation output to", outDir)
seed(seed_v)
write(seed_v, filename = outDir + "/seed.txt")

# taxa
for (i in 1:n_taxa) {
  if (i < 10) {
    taxa[i] = taxon("tip_0" + i)
  } else {
    taxa[i] = taxon("tip_" + i)
  }
}

# tree
n_edge = 2 * n_taxa - 3
rel_br_lengths ~ dnDirichlet(rep(1.0, n_edge))
br_lengths := rel_br_lengths * length
topology ~ dnUniformTopology(taxa, clade(taxa[1]))
tr := treeAssembly(topology, br_lengths)
write(tr, filename = outDir + "/tree.nwk")

# root frequencies, equal
rootFreqMk := Simplex(1.0, 1.0)

# single partition, simulated apart but combined in the inference so it's ok

# neomorphic characters
neo_chars ~ dnPhyloCTMC(
  tree = tr,
  Q = fnJC(2),
  rootFrequencies = rootFreqMk,
  coding = "variable",
  nSites = n_neo,
  type  = "Standard"
)
writeNexus(filename = outDir + "/neo.nex", neo_chars)

# transformational characters
trans_chars ~ dnPhyloCTMC(
  tree = tr,
  Q = fnJC(2),
  rootFrequencies = rootFreqMk,
  coding = "variable",
  nSites = n_trans,
  type = "Standard"
)

writeNexus(filename = outDir + "/trans.nex", trans_chars)
write("Mk simulation complete.")
