#Model 7 (replacement): Shared Q misspecification
#
# Partitioning : Two (neo | trans)
# Neo Q  : Asymmetric fnFreeBinary
# Trans Q : Asymmetric fnFreeBinary, but forced to SHARE neo's gain/loss ratio
# APRV : Present (partition rate scalar, estimated separately per partition — unchanged from M8)
# ACRV  : Present (shared lognormal, 4 categories)
# Root freq : Stationary
#
# Purpose: In the true NT generative model, trans characters are ALWAYS
# simulated under a symmetric process (fnJC(2) — gain = loss), while only
# neo characters carry the asymmetric gain/loss dynamics (rate_loss, sim
# arg 5). This model forces both partitions to share a single estimated
# gain/loss ratio, driven mostly by the neo signal, and imposes it on
# trans data that in truth has no asymmetry at all.
#
# As the simulated gain_loss parameter departs from 1.0 (i.e. neo becomes
# more asymmetric), this misspecification should worsen — giving a
# gradient result directly against an existing 4-level grid axis
# (gain_loss = 0.1, 0.25, 0.5, 1.0), rather than a flat yes/no answer.
#
# Partition rate scalars (APRV) remain separately estimated, exactly as
# in M8 — only the Q asymmetry parameter is tied across partitions. This
# keeps the model structurally distinct from both the single-partition
# models (M1–M3, which merge neo+trans into one dnPhyloCTMC call and lose
# per-partition ascertainment correction) and from the shared-APRV
# replacement (M9), which instead ties the rate scalar and leaves Q free.

taxa  <- neo.names()
nTaxa <- neo.size()
nEdge <- 2 * nTaxa - 3

moves = VectorMoves()

#--- Tree topology
topology ~ dnUniformTopology(taxa)
moves.append( mvNNI(topology, weight = nEdge / 2.0) )
moves.append( mvSPR(topology, weight = nEdge / 8.0) )

#--- Branch lengths (compound Dirichlet)
gamma_shape <- 2
exp_steps   <- 1
tree_length ~ dnGamma(shape = gamma_shape, rate = gamma_shape / exp_steps)
moves.append( mvScale(tree_length, weight = 1.0) )

rel_br_lengths ~ dnDirichlet( rep(1.0, nEdge) )
moves.append( mvBetaSimplex(rel_br_lengths,      weight = nEdge / 3.0) )
moves.append( mvDirichletSimplex(rel_br_lengths, weight = nEdge / 20.0) )
br_lengths := rel_br_lengths * tree_length

phylogeny := treeAssembly(topology, br_lengths)

#--- APRV: partition rate scalar (unchanged from M8 — separately estimated)
part_rate_neo   <- 1.0
part_rate_trans ~ dnExponential(1.0)
moves.append( mvScale(part_rate_trans, weight = 1.0) )

#--- Shared asymmetric Q: ONE gain/loss ratio applied to both partitions
gain_loss_shared ~ dnLognormal(0, 1)
moves.append( mvScale(gain_loss_shared, weight = 1.0) )
Q_neo   := fnFreeBinary( simplex(1, gain_loss_shared), rescaled = TRUE )
Q_trans := fnFreeBinary( simplex(1, gain_loss_shared), rescaled = TRUE )

#--- ACRV: shared lognormal discretised into 4 rate categories (unchanged from M8)
NUM_RATE_CATS <- 4
acrv_sd ~ dnExponential(1.0)
moves.append( mvScale(acrv_sd, weight = 1.0) )
site_rates := fnDiscretizeDistribution(
  dnLognormal(-acrv_sd^2 / 2, acrv_sd), NUM_RATE_CATS
)

#--- Model: two partitions, SHARED asymmetric Q, lognormal ACRV
m_neo ~ dnPhyloCTMC(
  tree        = phylogeny,
  Q           = Q_neo,
  branchRates = part_rate_neo,
  siteRates   = site_rates,
  type        = "Standard",
  coding      = "variable"
)
m_neo.clamp(neo)

m_trans ~ dnPhyloCTMC(
  tree        = phylogeny,
  Q           = Q_trans,
  branchRates = part_rate_trans,
  siteRates   = site_rates,
  type        = "Standard",
  coding      = "variable"
)
m_trans.clamp(trans)

#--- Monitors
mymodel = model(phylogeny)
monitors = VectorMonitors()
monitors.append( mnScreen(printgen = 300, prior = FALSE, posterior = FALSE) )
