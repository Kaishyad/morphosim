# model 7
#
# partitioning : two (neo | trans)
# neo q        : asymmetric fnFreeBinary
# trans q      : symmetric fnJC(2) - matches the nt simulation's trans generative process
# aprv         : present (partition rate scalar)
# acrv         : present (gamma, 4 categories)
# root freq    : stationary
#
# full nt model with gamma-distributed acrv. comparing m7 vs m8 (lognormal)
# vs m9 (free rates) tests whether the acrv distributional assumption
# affects inference accuracy - m7 is the gamma baseline.

taxa  <- neo.names()
nTaxa <- neo.size()
nEdge <- 2 * nTaxa - 3

moves = VectorMoves()

# tree topology
topology ~ dnUniformTopology(taxa)
moves.append( mvNNI(topology, weight = nEdge / 2.0) )
moves.append( mvSPR(topology, weight = nEdge / 8.0) )

# branch lengths (compound dirichlet)
gamma_shape <- 2
exp_steps   <- 1
tree_length ~ dnGamma(shape = gamma_shape, rate = gamma_shape / exp_steps)
moves.append( mvScale(tree_length, weight = 1.0) )

rel_br_lengths ~ dnDirichlet( rep(1.0, nEdge) )
moves.append( mvBetaSimplex(rel_br_lengths,      weight = nEdge / 3.0) )
moves.append( mvDirichletSimplex(rel_br_lengths, weight = nEdge / 20.0) )
br_lengths := rel_br_lengths * tree_length

phylogeny := treeAssembly(topology, br_lengths)

# aprv: partition rate scalar
part_rate_neo   <- 1.0
part_rate_trans ~ dnExponential(1.0)
moves.append( mvScale(part_rate_trans, weight = 1.0) )

# asymmetric q matrices
gain_loss_neo ~ dnLognormal(0, 1)
moves.append( mvScale(gain_loss_neo, weight = 1.0) )
Q_neo := fnFreeBinary( simplex(1, gain_loss_neo), rescaled = TRUE )

Q_trans <- fnJC(2)

# acrv: gamma, 4 discretised rate categories. shape alpha controls variance
# (small alpha = high variance); mean fixed to 1 by setting rate = alpha.
NUM_RATE_CATS  <- 4
alpha ~ dnExponential(1.0)
moves.append( mvScale(alpha, weight = 1.0) )
site_rates := fnDiscretizeDistribution(
  dnGamma(alpha, alpha), NUM_RATE_CATS
)

# model: two partitions, asymmetric q, gamma acrv
m_neo ~ dnPhyloCTMC(
  tree        = phylogeny,
  Q           = Q_neo,
  branchRates = part_rate_neo,
  siteRates   = site_rates,
  type        = "Standard",
  coding      = "variable"
)
m_neo.clamp(neo)

m_trans ~ dnPhyloCTMC(
  tree        = phylogeny,
  Q           = Q_trans,
  branchRates = part_rate_trans,
  siteRates   = site_rates,
  type        = "Standard",
  coding      = "variable"
)
m_trans.clamp(trans)

# monitors
mymodel = model(phylogeny)
monitors = VectorMonitors()
monitors.append( mnScreen(printgen = 300, prior = FALSE, posterior = FALSE) )
