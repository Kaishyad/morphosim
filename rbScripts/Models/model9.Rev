# model 9
#
# partitioning : two (neo | trans)
# neo q        : asymmetric fnFreeBinary
# trans q      : symmetric fnJC(2) - matches the nt simulation's trans generative process
# aprv         : present (partition rate scalar)
# acrv         : present (free rates, 4 categories)
# root freq    : stationary
#
# free rates makes no parametric assumption about the rate distribution -
# both the rate values and their weights are estimated from the data. it's
# the non-parametric upper bound: if m9 doesn't outperform m8, the lognormal
# assumption in the nt generative model is adequate. it also costs more
# parameters (2*NUM_RATE_CATS - 1 vs 1), so it's an implicit
# over-parameterisation test at low character counts.

taxa  <- neo.names()
nTaxa <- neo.size()
nEdge <- 2 * nTaxa - 3

moves = VectorMoves()

# tree topology
topology ~ dnUniformTopology(taxa)
moves.append( mvNNI(topology, weight = nEdge / 2.0) )
moves.append( mvSPR(topology, weight = nEdge / 8.0) )

# branch lengths (compound dirichlet)
gamma_shape <- 2
exp_steps   <- 1
tree_length ~ dnGamma(shape = gamma_shape, rate = gamma_shape / exp_steps)
moves.append( mvScale(tree_length, weight = 1.0) )

rel_br_lengths ~ dnDirichlet( rep(1.0, nEdge) )
moves.append( mvBetaSimplex(rel_br_lengths,      weight = nEdge / 3.0) )
moves.append( mvDirichletSimplex(rel_br_lengths, weight = nEdge / 20.0) )
br_lengths := rel_br_lengths * tree_length

phylogeny := treeAssembly(topology, br_lengths)

# aprv: partition rate scalar
part_rate_neo   <- 1.0
part_rate_trans ~ dnExponential(1.0)
moves.append( mvScale(part_rate_trans, weight = 1.0) )

# asymmetric q matrices
gain_loss_neo ~ dnLognormal(0, 1)
moves.append( mvScale(gain_loss_neo, weight = 1.0) )
Q_neo := fnFreeBinary( simplex(1, gain_loss_neo), rescaled = TRUE )

Q_trans <- fnJC(2)

# acrv: free rates (non-parametric). rate values are drawn i.i.d. from an
# unconstrained exponential prior, independent of one another; category
# weights are drawn from a dirichlet so they sum to 1. rates are rescaled
# so the weighted mean equals 1, preserving identifiability with tree_length.
NUM_RATE_CATS <- 4

for (i in 1:NUM_RATE_CATS) {
  site_rates_raw[i] ~ dnExponential(1.0)
  moves.append( mvScale(site_rates_raw[i], weight = 1.0) )
}

site_rate_weights ~ dnDirichlet( rep(1.0, NUM_RATE_CATS) )
moves.append( mvBetaSimplex(site_rate_weights,      weight = NUM_RATE_CATS / 3.0) )
moves.append( mvDirichletSimplex(site_rate_weights, weight = 1.0) )

# weighted mean-normalised rates; site_rates_raw is a vector of independent
# RealPos scalars (not a Simplex), so elementwise multiplication with the
# Simplex weights needs an explicit loop
for (i in 1:NUM_RATE_CATS) {
  weighted_term[i] := site_rates_raw[i] * site_rate_weights[i]
}
mean_rate  := sum(weighted_term)
site_rates := site_rates_raw / mean_rate

# model: two partitions, asymmetric q, free rates acrv
m_neo ~ dnPhyloCTMC(
  tree        = phylogeny,
  Q           = Q_neo,
  branchRates = part_rate_neo,
  siteRates   = site_rates,
  type        = "Standard",
  coding      = "variable"
)
m_neo.clamp(neo)

m_trans ~ dnPhyloCTMC(
  tree        = phylogeny,
  Q           = Q_trans,
  branchRates = part_rate_trans,
  siteRates   = site_rates,
  type        = "Standard",
  coding      = "variable"
)
m_trans.clamp(trans)

# monitors
mymodel = model(phylogeny)
monitors = VectorMonitors()
monitors.append( mnScreen(printgen = 300, prior = FALSE, posterior = FALSE) )
