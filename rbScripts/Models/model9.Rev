#Model 9 (replacement): Shared APRV misspecification
#
# Partitioning : Two (neo | trans)
# Neo Q  : Asymmetric fnFreeBinary (estimated separately — unchanged from M8)
# Trans Q : Asymmetric fnFreeBinary (estimated separately — unchanged from M8)
# APRV : Present but FORCED SHARED — one rate scalar applied to both partitions
# ACRV : Present (shared lognormal, 4 categories)
# Root freq : Stationary
#
# Purpose: part_rate is a dedicated, multi-level axis in the simulation
# grid (1.0, 2.5, 5.0), controlling how differently neo and trans
# characters evolve in rate. At part_rate = 1.0 the two partitions truly
# do evolve at the same rate (this model is correctly specified); at
# part_rate = 2.5 and 5.0 the true rates diverge by a known amount.
#
# This model forces a single shared rate scalar across both partitions
# instead of estimating them separately (as M8 does). It directly tests
# sensitivity to the APRV assumption as a function of an existing grid
# axis, giving a graded result (recovery accuracy vs. part_rate level)
# rather than a flat yes/no — and because every replicate already has
# ground truth for this axis, no new simulations are needed.
#
# Q asymmetry parameters remain separately estimated per partition,
# exactly as in M8 — only the rate scalar is tied across partitions.
# This is the mirror-image test to the shared-Q replacement (M7): here
# partition-specific Q is retained and rate is collapsed; there,
# partition-specific rate is retained and Q is collapsed.

taxa  <- neo.names()
nTaxa <- neo.size()
nEdge <- 2 * nTaxa - 3

moves = VectorMoves()

#--- Tree topology
topology ~ dnUniformTopology(taxa)
moves.append( mvNNI(topology, weight = nEdge / 2.0) )
moves.append( mvSPR(topology, weight = nEdge / 8.0) )

#--- Branch lengths (compound Dirichlet)
gamma_shape <- 2
exp_steps   <- 1
tree_length ~ dnGamma(shape = gamma_shape, rate = gamma_shape / exp_steps)
moves.append( mvScale(tree_length, weight = 1.0) )

rel_br_lengths ~ dnDirichlet( rep(1.0, nEdge) )
moves.append( mvBetaSimplex(rel_br_lengths,      weight = nEdge / 3.0) )
moves.append( mvDirichletSimplex(rel_br_lengths, weight = nEdge / 20.0) )
br_lengths := rel_br_lengths * tree_length

phylogeny := treeAssembly(topology, br_lengths)

#--- APRV: SHARED partition rate scalar (both fixed to 1 — no differential rate)
part_rate_neo   <- 1.0
part_rate_trans <- 1.0

#--- Asymmetric Q matrices (unchanged from M8 — separately estimated)
gain_loss_neo ~ dnLognormal(0, 1)
moves.append( mvScale(gain_loss_neo, weight = 1.0) )
Q_neo := fnFreeBinary( simplex(1, gain_loss_neo), rescaled = TRUE )

gain_loss_trans ~ dnLognormal(0, 1)
moves.append( mvScale(gain_loss_trans, weight = 1.0) )
Q_trans := fnFreeBinary( simplex(1, gain_loss_trans), rescaled = TRUE )

#--- ACRV: shared lognormal discretised into 4 rate categories (unchanged from M8)
NUM_RATE_CATS <- 4
acrv_sd ~ dnExponential(1.0)
moves.append( mvScale(acrv_sd, weight = 1.0) )
site_rates := fnDiscretizeDistribution(
  dnLognormal(-acrv_sd^2 / 2, acrv_sd), NUM_RATE_CATS
)

#--- Model: two partitions, asymmetric Q, SHARED rate, lognormal ACRV
m_neo ~ dnPhyloCTMC(
  tree        = phylogeny,
  Q           = Q_neo,
  branchRates = part_rate_neo,
  siteRates   = site_rates,
  type        = "Standard",
  coding      = "variable"
)
m_neo.clamp(neo)

m_trans ~ dnPhyloCTMC(
  tree        = phylogeny,
  Q           = Q_trans,
  branchRates = part_rate_trans,
  siteRates   = site_rates,
  type        = "Standard",
  coding      = "variable"
)
m_trans.clamp(trans)

#--- Monitors
mymodel = model(phylogeny)
monitors = VectorMonitors()
monitors.append( mnScreen(printgen = 300, prior = FALSE, posterior = FALSE) )
