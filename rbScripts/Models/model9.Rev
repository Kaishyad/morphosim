#Model 9

# Partitioning : Two (neo | trans)
# Neo Q  : Asymmetric fnFreeBinary
# Trans Q : Asymmetric fnFreeBinary
# APRV : Present (partition rate scalar)
# ACRV  : Present (free rates, 4 categories)
# Root freq : Stationary

#Free rates makes noparametric assumption about the shape of the rate distribution both the rate values and their weights are estimated from the data
#It is the most flexible ACRV option and serves as the non-parametric upper bound. If M9 does not outperform
#M8, the lognormal assumption in the NT generative model is adequate.
#Free rates costs more parameters (2*NUM_RATE_CATS - 1 vs 1) so it is also an implicit over-parameterisation test at low character counts.

taxa  <- neo.names()
nTaxa <- neo.size()
nEdge <- 2 * nTaxa - 3

moves = VectorMoves()

#--- Tree topology
topology ~ dnUniformTopology(taxa)
moves.append( mvNNI(topology, weight = nEdge / 2.0) )
moves.append( mvSPR(topology, weight = nEdge / 8.0) )

#--- Branch lengths (compound Dirichlet)
gamma_shape <- 2
exp_steps   <- 1
tree_length ~ dnGamma(shape = gamma_shape, rate = gamma_shape / exp_steps)
moves.append( mvScale(tree_length, weight = 1.0) )

rel_br_lengths ~ dnDirichlet( rep(1.0, nEdge) )
moves.append( mvBetaSimplex(rel_br_lengths,      weight = nEdge / 3.0) )
moves.append( mvDirichletSimplex(rel_br_lengths, weight = nEdge / 20.0) )
br_lengths := rel_br_lengths * tree_length

phylogeny := treeAssembly(topology, br_lengths)

#--- APRV: partition rate scalar
part_rate_neo   <- 1.0
part_rate_trans ~ dnExponential(1.0)
moves.append( mvScale(part_rate_trans, weight = 1.0) )

#--- Asymmetric Q matrices
gain_loss_neo ~ dnLognormal(0, 1)
moves.append( mvScale(gain_loss_neo, weight = 1.0) )
Q_neo := fnFreeBinary( simplex(1, gain_loss_neo), rescaled = TRUE )

gain_loss_trans ~ dnLognormal(0, 1)
moves.append( mvScale(gain_loss_trans, weight = 1.0) )
Q_trans := fnFreeBinary( simplex(1, gain_loss_trans), rescaled = TRUE )

#--- ACRV: free rates (non-parametric)
#Rate values (site_rates_raw) and weights (site_rate_weights) are both
#estimated. Weights are drawn from a Dirichlet so they sum to 1.
#Rates are drawn iid from an Exponential; they are not constrained to
#sum to 1 internally but the PhyloCTMC likelihood marginalises correctly.
#Mean-one normalisation is implicit via the weight-averaged expectation.
NUM_RATE_CATS <- 4

site_rates_raw ~ dnDirichlet( rep(1.0, NUM_RATE_CATS) )
moves.append( mvBetaSimplex(site_rates_raw,      weight = NUM_RATE_CATS / 3.0) )
moves.append( mvDirichletSimplex(site_rates_raw, weight = 1.0) )

# Scale so the mean rate = 1 (identifiability with tree_length)
site_rate_weights ~ dnDirichlet( rep(1.0, NUM_RATE_CATS) )
moves.append( mvBetaSimplex(site_rate_weights,      weight = NUM_RATE_CATS / 3.0) )
moves.append( mvDirichletSimplex(site_rate_weights, weight = 1.0) )

# Weighted mean-normalised rates
site_rates := site_rates_raw / sum(site_rates_raw * site_rate_weights)

#--- Model: two partitions, asymmetric Q, free rates ACRV
m_neo ~ dnPhyloCTMC(
  tree        = phylogeny,
  Q           = Q_neo,
  branchRates = part_rate_neo,
  siteRates   = site_rates,
  type        = "Standard",
  coding      = "variable"
)
m_neo.clamp(neo)

m_trans ~ dnPhyloCTMC(
  tree        = phylogeny,
  Q           = Q_trans,
  branchRates = part_rate_trans,
  siteRates   = site_rates,
  type        = "Standard",
  coding      = "variable"
)
m_trans.clamp(trans)

#--- Monitors
mymodel = model(phylogeny)
monitors = VectorMonitors()
monitors.append( mnScreen(printgen = 300, prior = FALSE, posterior = FALSE) )