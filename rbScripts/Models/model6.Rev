# model 6
#
# partitioning : two (neo | trans)
# neo q        : symmetric fnJC(2)
# trans q      : symmetric fnJC(2)
# aprv         : present (partition rate scalar)
# acrv         : present (shared lognormal, 4 categories)
# root freq    : stationary
#
# adds acrv to m4's symmetric two-partition model, keeping q symmetric. a
# single shared lognormal rate distribution applies across both partitions,
# treating among-character rate variance as a property of the data as a
# whole rather than of each partition separately.

taxa  <- neo.names()
nTaxa <- neo.size()
nEdge <- 2 * nTaxa - 3

moves = VectorMoves()

# tree topology
topology ~ dnUniformTopology(taxa)
moves.append( mvNNI(topology, weight = nEdge / 2.0) )
moves.append( mvSPR(topology, weight = nEdge / 8.0) )

# branch lengths (compound dirichlet)
gamma_shape <- 2
exp_steps   <- 1
tree_length ~ dnGamma(shape = gamma_shape, rate = gamma_shape / exp_steps)
moves.append( mvScale(tree_length, weight = 1.0) )

rel_br_lengths ~ dnDirichlet( rep(1.0, nEdge) )
moves.append( mvBetaSimplex(rel_br_lengths,      weight = nEdge / 3.0) )
moves.append( mvDirichletSimplex(rel_br_lengths, weight = nEdge / 20.0) )
br_lengths := rel_br_lengths * tree_length

phylogeny := treeAssembly(topology, br_lengths)

# aprv: partition rate scalar
part_rate_neo   <- 1.0
part_rate_trans ~ dnExponential(1.0)
moves.append( mvScale(part_rate_trans, weight = 1.0) )

# acrv: shared lognormal, 4 discretised rate categories, one acrv_sd shared
# across both partitions. mean-one parameterisation (mu = -sd^2/2) keeps
# acrv from confounding with the overall tree length.
NUM_RATE_CATS <- 4
acrv_sd ~ dnExponential(1.0)
moves.append( mvScale(acrv_sd, weight = 1.0) )
site_rates := fnDiscretizeDistribution(
  dnLognormal(-acrv_sd^2 / 2, acrv_sd), NUM_RATE_CATS
)

# model: two partitions, symmetric mk, shared acrv
m_neo ~ dnPhyloCTMC(
  tree        = phylogeny,
  Q           = fnJC(2),
  branchRates = part_rate_neo,
  siteRates   = site_rates,
  type        = "Standard",
  coding      = "variable"
)
m_neo.clamp(neo)

m_trans ~ dnPhyloCTMC(
  tree        = phylogeny,
  Q           = fnJC(2),
  branchRates = part_rate_trans,
  siteRates   = site_rates,
  type        = "Standard",
  coding      = "variable"
)
m_trans.clamp(trans)

# monitors
mymodel = model(phylogeny)
monitors = VectorMonitors()
monitors.append( mnScreen(printgen = 300, prior = FALSE, posterior = FALSE) )
