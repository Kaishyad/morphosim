# Model 12 (v4): optimized state-space inflation, building on Model 11

# Partitioning : Single (neo + trans combined) -- same as M11
# Q    : 9-state Mk, but with ESTIMATED symmetric exchange rates (fnGTR-style) instead of M11 fixed fnJC(9)
# APRV  : Absent  same as M11
# ACRV : Absent  same as M11
# Root freq : Stationary, fixed equal (1/9 each) -- same as M11



allChars <- concatenate(neo, trans)
taxa  <- allChars.names()
nTaxa <- allChars.size()
nEdge <- 2 * nTaxa - 3

moves = VectorMoves()

#--- Tree topology
topology ~ dnUniformTopology(taxa)
moves.append( mvNNI(topology, weight = nEdge / 2.0) )
moves.append( mvSPR(topology, weight = nEdge / 8.0) )

#--- Branch lengths (compound Dirichlet)
gamma_shape <- 2
exp_steps   <- 1
tree_length ~ dnGamma(shape = gamma_shape, rate = gamma_shape / exp_steps)
moves.append( mvScale(tree_length, weight = 1.0) )

rel_br_lengths ~ dnDirichlet( rep(1.0, nEdge) )
moves.append( mvBetaSimplex(rel_br_lengths,      weight = nEdge / 3.0) )
moves.append( mvDirichletSimplex(rel_br_lengths, weight = nEdge / 20.0) )
br_lengths := rel_br_lengths * tree_length

phylogeny := treeAssembly(topology, br_lengths)

#--- Q matrix: 9-state, ESTIMATED symmetric exchange rates, equal frequencies
# n_states*(n_states-1)/2 = 36 symmetric exchangeabilities. Frequencies are
# held fixed and equal (not estimated) so this model differs from M11 in
#  the exchange ratesand doesn't also confound the root-frequency axis.
n_states <- 9
n_rates  <- (n_states * (n_states - 1)) / 2

er_morph ~ dnDirichlet( rep(1.0, n_rates) )
moves.append( mvBetaSimplex(er_morph,      weight = 2.0) )
moves.append( mvDirichletSimplex(er_morph, weight = 1.0) )

bf_morph <- simplex( rep(1.0, n_states) )

Q_morph := fnGTR(er_morph, bf_morph)

#--- Model: single partition, 9-state, estimated exchange rates
m_morph ~ dnPhyloCTMC(
  tree   = phylogeny,
  Q      = Q_morph,
  type   = "Standard",
  coding = "variable"
)
m_morph.clamp(allChars)

#--- Monitors
mymodel = model(phylogeny)
monitors = VectorMonitors()
monitors.append( mnScreen(printgen = 300, prior = FALSE, posterior = FALSE) )
