# Model 12: Random partition assignment — partition misspecification
#
# Partitioning : Two (randomly assigned, not neo|trans)
# Neo Q        : Symmetric fnJC(2)
# Trans Q      : Symmetric fnJC(2)
# APRV         : Present (partition rate scalar)
# ACRV         : Absent
# Root freq    : Stationary
#
# Purpose: tests whether the NT-informed partition assignment (neo vs
# trans) is doing useful biological work, or whether any arbitrary
# two-partition split would perform similarly. Characters are assigned
# to partitions at random (50/50 split, done in R prior to inference
# via Infer.R shuffling the character indices), breaking the neo/trans
# biological grouping while preserving the 2-partition model structure.
#
# The model is otherwise identical to M4 (2-partition symmetric Mk
# with APRV). Comparing M12 vs M4 directly isolates the contribution
# of informed partition assignment. If M12 ≈ M4, the biological
# partitioning adds no value. If M4 > M12, the NT partition structure
# is doing real inferential work.
#
# Implementation note: the random partition split is applied in
# Infer.R before this file is called. The character matrices passed
# in as `neo` and `trans` here are the randomly reassigned partitions,
# not the biologically meaningful ones. No change to this Rev file
# is needed across replicates — the randomisation is upstream.

taxa  <- neo.names()
nTaxa <- neo.size()
nEdge <- 2 * nTaxa - 3

moves = VectorMoves()

#--- Tree topology
topology ~ dnUniformTopology(taxa)
moves.append( mvNNI(topology, weight = nEdge / 2.0) )
moves.append( mvSPR(topology, weight = nEdge / 8.0) )

#--- Branch lengths (compound Dirichlet)
gamma_shape <- 2
exp_steps   <- 1
tree_length ~ dnGamma(shape = gamma_shape, rate = gamma_shape / exp_steps)
moves.append( mvScale(tree_length, weight = 1.0) )

rel_br_lengths ~ dnDirichlet( rep(1.0, nEdge) )
moves.append( mvBetaSimplex(rel_br_lengths,      weight = nEdge / 3.0) )
moves.append( mvDirichletSimplex(rel_br_lengths, weight = nEdge / 20.0) )
br_lengths := rel_br_lengths * tree_length

phylogeny := treeAssembly(topology, br_lengths)

#--- APRV: partition rate scalar
# Same parameterisation as M4 — neo partition rate fixed to 1,
# trans partition rate estimated. For the random partition case the
# labels "neo" and "trans" refer only to the randomly assigned
# character sets, not to biological categories.
part_rate_neo   <- 1.0
part_rate_trans ~ dnExponential(1.0)
moves.append( mvScale(part_rate_trans, weight = 1.0) )

#--- Model: two random partitions, both symmetric Mk
m_neo ~ dnPhyloCTMC(
  tree        = phylogeny,
  Q           = fnJC(2),
  branchRates = part_rate_neo,
  type        = "Standard",
  coding      = "variable"
)
m_neo.clamp(neo)

m_trans ~ dnPhyloCTMC(
  tree        = phylogeny,
  Q           = fnJC(2),
  branchRates = part_rate_trans,
  type        = "Standard",
  coding      = "variable"
)
m_trans.clamp(trans)

#--- Monitors
mymodel = model(phylogeny)
monitors = VectorMonitors()
monitors.append( mnScreen(printgen = 300, prior = FALSE, posterior = FALSE) )
