# model 11
#
# partitioning : single (neo + trans combined)
# q            : symmetric mk, 9 states (fnJC(9))
# aprv         : absent
# acrv         : absent
# root freq    : stationary
#
# targeted misspecification test for state space. the nt generative model
# uses binary (2-state) characters; this model applies a 9-state mk matrix
# to the same binary data, as if each character could take 9 values rather
# than 2 - mimicking a common real-world error of applying multistate mk to
# data better described by a binary process (9 states reflects the typical
# upper bound of morphological character states in empirical datasets). any
# degradation in tree accuracy relative to m1 is attributable solely to
# state space misspecification.

allChars <- concatenate(neo, trans)
taxa  <- allChars.names()
nTaxa <- allChars.size()
nEdge <- 2 * nTaxa - 3

moves = VectorMoves()

# tree topology
topology ~ dnUniformTopology(taxa)
moves.append( mvNNI(topology, weight = nEdge / 2.0) )
moves.append( mvSPR(topology, weight = nEdge / 8.0) )

# branch lengths (compound dirichlet)
gamma_shape <- 2
exp_steps   <- 1
tree_length ~ dnGamma(shape = gamma_shape, rate = gamma_shape / exp_steps)
moves.append( mvScale(tree_length, weight = 1.0) )

rel_br_lengths ~ dnDirichlet( rep(1.0, nEdge) )
moves.append( mvBetaSimplex(rel_br_lengths,      weight = nEdge / 3.0) )
moves.append( mvDirichletSimplex(rel_br_lengths, weight = nEdge / 20.0) )
br_lengths := rel_br_lengths * tree_length

phylogeny := treeAssembly(topology, br_lengths)

# model: single partition, 9-state symmetric mk. fnJC(9) produces a 9x9
# equal-rates matrix with stationary frequencies fixed at 1/9 each; applied
# to binary data, only the 0 and 1 rows/columns will have non-zero data
# likelihood.
m_morph ~ dnPhyloCTMC(
  tree   = phylogeny,
  Q      = fnJC(9),
  type   = "Standard",
  coding = "variable"
)
m_morph.clamp(allChars)

# monitors
mymodel = model(phylogeny)
monitors = VectorMonitors()
monitors.append( mnScreen(printgen = 300, prior = FALSE, posterior = FALSE) )
