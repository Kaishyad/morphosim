# Imputation inference
# Identical to sim-mc3.Rev except:
#   Reads masked matrices (imp_neo.nex, imp_trans.nex) instead of originals.
#   Adds mnJointConditionalAncestralState monitor(s), writing .states files
#       used by ScoreImputation().
#
# Two-partition models (4,5,6,7,8,9,10): separate m_neo/m_trans nodes ->
#   imp_neo_run_N.states, imp_trans_run_N.states (unchanged from before).
# Single-partition models (1,2,3,11,12): one combined m_morph node, built
#   as concatenate(neo, trans) with neo characters first -- confirmed
#   identical ordering in all five model scripts. Monitored once into
#   imp_morph_run_N.states; ScoreImputation() splits it back into neo/trans
#   column ranges using nNeoChar.

simDir = args[1]
outDir = args[2]
script = args[3]
minEss = args[4]
seed_v = args[5]

print("Timestamp:", time("year"), time("day"), time("seconds") / 60 / 60)
seed(seed_v)

maxPSRF = 1.01

write(getwd())

neo   <- readDiscreteCharacterData(simDir + "/imp_neo.nex")
trans <- readDiscreteCharacterData(simDir + "/imp_trans.nex")

# Character count for each partition -- needed by single-partition models
# so R can split the combined m_morph states file back into neo/trans
# column ranges (neo columns 1..nNeoChar, trans columns after that).
nNeoChar   = neo.nchar()
nTransChar = trans.nchar()

filePrefix = outDir + "/imp_" + script
ckpFile    = outDir + "/imp_" + script + ".ckp"
paramFile  = outDir + "/imp_" + script + ".p.log"

source("rbScripts/Models/" + script + ".Rev")

checkFreq = 100

monitors.append( mnModel(filename = filePrefix + ".log",   printgen = 36) )
monitors.append( mnModel(filename = paramFile,             printgen = 6,
                         stochasticOnly = TRUE,
                         exclude = ["rel_br_lengths"]) )
monitors.append( mnFile(filename  = filePrefix + ".trees", printgen = 12,
                        phylogeny) )

# --- Ancestral state monitor(s) ---
# Single-partition models source a script that defines m_morph only, not
# m_neo/m_trans -- branch on the model name (fixed list, not runtime
# introspection, since Rev's exists() semantics for this are unreliable).
SINGLE_PARTITION = ["model1", "model2", "model3", "model11", "model12"]

isSingle = FALSE
for (i in 1:SINGLE_PARTITION.size()) {
  if (script == SINGLE_PARTITION[i]) { isSingle = TRUE }
}

if (isSingle) {
  monitors.append( mnJointConditionalAncestralState(
    filename   = outDir + "/imp_morph.states",
    printgen   = 12,
    tree       = phylogeny,
    ctmc       = m_morph,
    type       = "Standard"
  ) )
  print("   Single-partition model (" + script + ") -- monitoring combined m_morph.")
  print("   nNeoChar=" + nNeoChar + " nTransChar=" + nTransChar + " (neo columns first, per concatenate(neo, trans))")
} else {
  monitors.append( mnJointConditionalAncestralState(
    filename   = outDir + "/imp_neo.states",
    printgen   = 12,
    tree       = phylogeny,
    ctmc       = m_neo,
    type       = "Standard"
  ) )
  monitors.append( mnJointConditionalAncestralState(
    filename   = outDir + "/imp_trans.states",
    printgen   = 12,
    tree       = phylogeny,
    ctmc       = m_trans,
    type       = "Standard"
  ) )
}

mymc3 = mcmcmc(
  mymodel, monitors, moves,
  nruns      = 2,
  nchains    = 8,
  tuneHeat   = TRUE,
  swapMethod = "both",
  swapMode   = "multiple",
  combine    = "none"
)
print("   Created MCMCMC object")

if (fileExists(outDir + "/imp_" + script + "_run_1_chain_0.ckp")) {
  print("   Initializing from checkpoint")
  mymc3.initializeFromCheckpoint(ckpFile)
  runHours = 23
} else {
  mymc3.burnin(generations = 1200, tuningInterval = checkFreq * 3)
  runHours = 23
}

stopping_rules[1] = srMaxTime(runHours, "hours")
stopping_rules[2] = srMinESS(minEss, paramFile, checkFreq, "ESS")
stopping_rules[3] = srGelmanRubin(maxPSRF, paramFile, checkFreq)

print("   Commencing imputation MCMCMC run with " + script + " at",
      time("year"), time("day"), time("seconds") / 60 / 60)

mymc3.run(
  rules              = stopping_rules,
  checkpointFile     = ckpFile,
  checkpointInterval = checkFreq,
  verbose            = 1
)

print("  # # # IMPUTATION RUN COMPLETE # # #  ")
print("Timestamp:", time("year"), time("day"), time("seconds") / 60 / 60)
q()
