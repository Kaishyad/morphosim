# Imputation inference
# Identical to sim-mc3.Rev except:
#   Reads masked matrices (imp_neo.nex, imp_trans.nex) instead of originals.
#   Adds mnJointConditionalAncestralState monitors for both partitions,
#       writing imp_run_{N}.states files used by ScoreImputation().

# Arguments (positional):
#   args[1] = simDir   path to simulation directory containing imp_neo.nex, imp_trans.nex
#   args[2] = outDir   path to inference output directory (results_imputation/scenario/gridTag/repID/modelID)
#   args[3] = script   model script name without .Rev (e.g. "model1")
#   args[4] = minEss   minimum ESS stopping criterion (default: 333)
#   args[5] = seed_v   random seed (default: 0)

# --- Argument parsing ---
simDir = args[1]
outDir = args[2]
script = args[3]
minEss = args[4]
seed_v = args[5]

print("Timestamp:", time("year"), time("day"), time("seconds") / 60 / 60)
seed(seed_v)

maxPSRF = 1.01

write(getwd())

# --- Read masked data ---
# imp_neo.nex and imp_trans.nex are the masked versions of neo.nex / trans.nex,
# generated by MaskReplicate() before this script is submitted.
neo   <- readDiscreteCharacterData(simDir + "/imp_neo.nex")
trans <- readDiscreteCharacterData(simDir + "/imp_trans.nex")

# --- File paths ---
# All outputs go to outDir (results_imputation/), fully separate from both
# the simulated data AND from standard inference output (results/) -- the
# imp_ filename prefix is kept too, belt-and-suspenders.
filePrefix = outDir + "/imp_" + script
ckpFile    = outDir + "/imp_" + script + ".ckp"
paramFile  = outDir + "/imp_" + script + ".p.log"

# --- Source model script ---
source("rbScripts/Models/" + script + ".Rev")

checkFreq = 100

# --- Monitors ---
monitors.append( mnModel(filename = filePrefix + ".log",   printgen = 36) )
monitors.append( mnModel(filename = paramFile,             printgen = 6,
                         stochasticOnly = TRUE,
                         exclude = ["rel_br_lengths"]) )
monitors.append( mnFile(filename  = filePrefix + ".trees", printgen = 12,
                        phylogeny) )

# --- Ancestral state monitors ---
# One monitor per partition; RevBayes appends _run_{N} to the filename automatically.
# ScoreImputation() reads imp_run_{N}.states and compares MAP tip states
# at masked positions to the known true states from the original nexus files.
#
# KNOWN LIMITATION: this assumes a two-partition model (m_neo/m_trans as
# separate CTMC nodes) -- true for models 4,5,6,7,8,9,10. Single-partition
# models (1,2,3,11,12) only expose one combined `m_morph` node covering
# both partitions at once, so this script cannot currently run imputation
# for them -- it will fail before reaching here (m_neo/m_trans undefined).
# Supporting those would need m_morph's ancestral states monitored once,
# then ScoreImputation() taught to split the combined states file back into
# neo/trans column ranges -- not done yet.
monitors.append( mnJointConditionalAncestralState(
  filename   = outDir + "/imp_neo.states",
  printgen   = 12,
  tree       = phylogeny,
  ctmc       = m_neo,
  type       = "Standard"
) )
monitors.append( mnJointConditionalAncestralState(
  filename   = outDir + "/imp_trans.states",
  printgen   = 12,
  tree       = phylogeny,
  ctmc       = m_trans,
  type       = "Standard"
) )

# --- MC³ setup ---
mymc3 = mcmcmc(
  mymodel, monitors, moves,
  nruns      = 2,
  nchains    = 8,
  tuneHeat   = TRUE,
  swapMethod = "both",
  swapMode   = "multiple",
  combine    = "none"
)
print("   Created MCMCMC object")

# --- Burnin or resume from checkpoint ---
if (fileExists(outDir + "/imp_" + script + "_run_1_chain_0.ckp")) {
  print("   Initializing from checkpoint")
  mymc3.initializeFromCheckpoint(ckpFile)
  runHours = 23
} else {
  mymc3.burnin(generations = 1200, tuningInterval = checkFreq * 3)
  runHours = 23
}

# --- Stopping rules ---
stopping_rules[1] = srMaxTime(runHours, "hours")
stopping_rules[2] = srMinESS(minEss, paramFile, checkFreq, "ESS")
stopping_rules[3] = srGelmanRubin(maxPSRF, paramFile, checkFreq)

print("   Commencing imputation MCMCMC run with " + script + " at",
      time("year"), time("day"), time("seconds") / 60 / 60)

mymc3.run(
  rules              = stopping_rules,
  checkpointFile     = ckpFile,
  checkpointInterval = checkFreq,
  verbose            = 1
)

print("  # # # IMPUTATION RUN COMPLETE # # #  ")
print("Timestamp:", time("year"), time("day"), time("seconds") / 60 / 60)
q()
