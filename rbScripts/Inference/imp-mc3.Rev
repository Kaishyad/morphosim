#Imputation inference 
# Identical to sim-mc3.Rev except:
#  Reads masked matrices (imp_neo.nex, imp_trans.nex) instead of originals.
#  Adds mnJointConditionalAncestralState monitors for both partitions,
#      writing imp_{script}_run_{N}.states files used by ScoreImputation().

#   args[1]  simDir   path to simulation directory containing imp_neo.nex, imp_trans.nex
#   args[2]  script   model script name without .Rev (e.g. "model1")
#   args[3]  minEss   minimum ESS stopping criterion (default: 333)
#   args[4]  seed_v   random seed (default: 0)

# --- Argument parsing ---
simDir = args[1]
script = args[2]
minEss = args[3]
seed_v = args[4]

print("Timestamp:", time("year"), time("day"), time("seconds") / 60 / 60)
seed(seed_v)

maxPSRF = 1.01

write(getwd())

# --- Read masked data ---
# imp_neo.nex and imp_trans.nex are the masked versions of neo.nex / trans.nex,
# generated by MaskReplicate() before this script is submitted.
neo   <- readDiscreteCharacterData(simDir + "/imp_neo.nex")
trans <- readDiscreteCharacterData(simDir + "/imp_trans.nex")

# --- File paths ---
filePrefix = simDir + "/imp_" + script
ckpFile    = filePrefix + ".ckp"
paramFile  = filePrefix + ".p.log"

# --- Source model script ---
source("rbScripts/Models/" + script + ".Rev")

checkFreq = 100

# --- Monitors ---
monitors.append( mnModel(filename = filePrefix + ".log",   printgen = 36) )
monitors.append( mnModel(filename = paramFile,             printgen = 6,
                         stochasticOnly = TRUE,
                         exclude = ["rel_br_lengths"]) )
monitors.append( mnFile(filename  = filePrefix + ".trees", printgen = 12,
                        phylogeny) )

# --- Ancestral state monitors ---
# One monitor per partition; RevBayes appends _run_{N} to the filename automatically.
# ScoreImputation() reads imp_{script}_run_{N}.states and compares MAP tip states
# at masked positions to the known true states from the original nexus files.
monitors.append( mnJointConditionalAncestralState(
  filename   = simDir + "/imp_" + script + "_neo.states",
  printgen   = 12,
  tree       = phylogeny,
  ctmc       = m_morph[1],
  type       = "Standard"
) )
monitors.append( mnJointConditionalAncestralState(
  filename   = simDir + "/imp_" + script + "_trans.states",
  printgen   = 12,
  tree       = phylogeny,
  ctmc       = m_morph[2],
  type       = "Standard"
) )

# --- MC³ setup ---
mymc3 = mcmcmc(
  mymodel, monitors, moves,
  nruns      = 2,
  nchains    = 8,
  tuneHeat   = TRUE,
  swapMethod = "both",
  swapMode   = "multiple",
  combine    = "none"
)
print("   Created MCMCMC object")

# --- Burnin or resume from checkpoint ---
if (fileExists(filePrefix + "_run_1_chain_0.ckp")) {
  print("   Initializing from checkpoint")
  mymc3.initializeFromCheckpoint(ckpFile)
  runHours = 23
} else {
  mymc3.burnin(generations = 1200, tuningInterval = checkFreq * 3)
  runHours = 23
}

# --- Stopping rules ---
stopping_rules[1] = srMaxTime(runHours, "hours")
stopping_rules[2] = srMinESS(minEss, paramFile, checkFreq, "ESS")
stopping_rules[3] = srGelmanRubin(maxPSRF, paramFile, checkFreq)

print("   Commencing imputation MCMCMC run with " + script + " at",
      time("year"), time("day"), time("seconds") / 60 / 60)

mymc3.run(
  rules              = stopping_rules,
  checkpointFile     = ckpFile,
  checkpointInterval = checkFreq,
  verbose            = 1
)

print("  # # # IMPUTATION RUN COMPLETE # # #  ")
print("Timestamp:", time("year"), time("day"), time("seconds") / 60 / 60)
q()
