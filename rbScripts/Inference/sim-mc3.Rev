# inference: reads simulated neo.nex/trans.nex from simdir, sources the
# specified model script, runs mc3 with stopping rules, and writes outputs
# to outdir.
#
#   args[1] = simDir   path to simulation directory containing neo.nex, trans.nex
#   args[2] = outDir   path to inference output directory (results/scenario/gridTag/repID/modelID)
#   args[3] = script   model script name without .Rev
#   args[4] = minEss   minimum ESS stopping criterion
#   args[5] = seed_v   random seed

# defaults
simDir = "simulations/nt/tl1.00_gl0.25_c25/sim001"
outDir = "results/nt/tl1.00_gl0.25_c25/sim001/model1"
script = "model1"
minEss = 333
seed_v = 0

# argument parsing
if (args.size() >= 1) { simDir = args[1] }
if (args.size() >= 2) { outDir = args[2] }
if (args.size() >= 3) { script = args[3] }
if (args.size() >= 4) { minEss = args[4] }
if (args.size() >= 5) { seed_v = args[5] }

print("Timestamp:", time("year"), time("day"), time("seconds") / 60 / 60)
seed(seed_v)

maxPSRF = 1.01

write(getwd())

# read simulated data
neo   <- readDiscreteCharacterData(simDir + "/neo.nex")
trans <- readDiscreteCharacterData(simDir + "/trans.nex")

# file paths
filePrefix = outDir + "/" + script
ckpFile    = outDir + "/" + script + ".ckp"
paramFile  = outDir + "/" + script + ".p.log"

# source model script
source("rbScripts/Models/" + script + ".Rev")

checkFreq = 100

# monitors
monitors.append( mnModel(filename = filePrefix + ".log",   printgen = 36) )
monitors.append( mnModel(filename = paramFile,             printgen = 6,
                         stochasticOnly = TRUE,
                         exclude = ["rel_br_lengths"]) )
monitors.append( mnFile(filename  = filePrefix + ".trees", printgen = 12,
                        phylogeny) )

# mc3 setup: 2 independent runs for asdsf convergence assessment, 8 chains
# per run (1 cold + 7 heated). tuneHeat lets chain temperatures adapt during
# burnin; swapMethod/swapMode maximise chain communication; combine = "none"
# keeps runs separate for psrf/asdsf calculation in r.
mymc3 = mcmcmc(
  mymodel, monitors, moves,
  nruns      = 2,
  nchains    = 8,
  tuneHeat   = TRUE,
  swapMethod = "both",
  swapMode   = "multiple",
  combine    = "none"
)
print("   Created MCMCMC object")

# burnin or resume from checkpoint
if (fileExists(outDir + "/" + script + "_run_1_chain_0.ckp")) {
  print("   Initializing from checkpoint")
  mymc3.initializeFromCheckpoint(ckpFile)
  runHours = 23
} else {
  mymc3.burnin(generations = 1200, tuningInterval = checkFreq * 3)
  runHours = 23
}

# stopping rules: whichever triggers first stops the run
# srMaxTime: hard wall at hamilton time limit
# srMinESS: stops early once minimum ess across parameters exceeds minEss
# srGelmanRubin: stops early once all parameters have psrf < maxPSRF
stopping_rules[1] = srMaxTime(runHours, "hours")
stopping_rules[2] = srMinESS(minEss, paramFile, checkFreq, "ESS")
stopping_rules[3] = srGelmanRubin(maxPSRF, paramFile, checkFreq)

# running
print("   Commencing MCMCMC run with " + script + " at",
      time("year"), time("day"), time("seconds") / 60 / 60)

mymc3.run(
  rules              = stopping_rules,
  checkpointFile     = ckpFile,
  checkpointInterval = checkFreq,
  verbose            = 1
)

print("  # # # RUN COMPLETE # # #  ")
print("Timestamp:", time("year"), time("day"), time("seconds") / 60 / 60)
q()
